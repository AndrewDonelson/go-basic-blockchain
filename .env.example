# Copy to .local.env and fill in. Never commit a populated env file.

BLOCKCHAIN_NAME=Go Basic Blockchain
BLOCKCHAIN_SYMBOL=GBB
BLOCK_TIME=20
DIFFICULTY=4
TRANSACTION_FEE=0.05
MINER_REWARD_PCT=50.00
DEV_REWARD_PCT=50.00
API_HOSTNAME=:8200
P2P_HOSTNAME=:8201
ENABLE_API=true
FUND_WALLET_AMOUNT=100.00
TOKEN_COUNT=33554432
TOKEN_PRICE=0.01
ALLOW_NEW_TOKENS=false
MAX_BLOCK_SIZE=1000000
MIN_TRANSACTION_FEE=0.01
VERBOSE=false

# REQUIRED. Authentication fails closed without these; there is deliberately no
# built-in fallback. Generate with: openssl rand -hex 32
BLOCKCHAIN_API_KEY=
BLOCKCHAIN_SERVER_SEED=

# Principal the static API key is issued to.
BLOCKCHAIN_API_EMAIL=local-dev

# Passphrase for the node's own wallet. If unset, one is generated and logged
# once at startup -- save it, or the wallet cannot be recovered.
NODE_WALLET_PASSPHRASE=

# Only enable behind a proxy you control: X-Forwarded-For is client-controlled.
TRUST_PROXY_HEADERS=false

# Restrict which peers may connect, by node ID (comma-separated). Empty admits
# any authenticated peer. A node's ID is the SHA-256 of its identity public key
# and is logged at startup; the key lives at {DATA_PATH}/node_identity.pem.
P2P_ALLOWED_PEERS=
