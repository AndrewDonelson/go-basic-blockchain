# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Test folder with output
test/

# do not allow saving of .env file
.env

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

bin/

# Blockchain data folders and files
_data/
data/
vendor/
data_test/
chaind_data/
cmd/chaind/chaind

# Blockchain test data and generated files
test_data/
**/test_data/
sdk/test_data/
**/data/
**/blocks/
**/wallets/
**/node.json
**/blockchain.json

# Blockchain wallet files (encrypted and unencrypted)
**/wallets/*.json
**/wallets/*.pem
**/wallets/*.key

# Blockchain block files
**/blocks/*.json
**/blocks/*.dat

# Blockchain configuration and state files
**/node.json
**/blockchain.json
**/config.json
**/state.json

# Blockchain logs and temporary files
*.log
*.tmp
*.temp
blockchain.log
node.log
api.log

# Blockchain database files
*.db
*.sqlite
*.sqlite3
blockchain.db
wallets.db

# Blockchain cache files
*.cache
cache/

# Blockchain backup files
*.bak
*.backup
backup/

# Blockchain lock files
*.lock
.lock

# Blockchain environment files
.env.local
.env.test
.env.production

# Blockchain certificates and keys
*.crt
*.key
*.pem
*.p12
*.pfx

# Blockchain runtime data directories
_data/
data/
data_test/
chaind_data/
test_data/
**/test_data/

# Blockchain wallet data files
**/wallets/

# Blockchain block data files
**/blocks/

# Blockchain configuration runtime files (only data files, not source)
**/config_data/
**/state_data/
**/node_runtime/
**/chain_data/

# Blockchain test artifacts and coverage
**/test_artifacts/
**/test_output/
**/coverage/
**/profiles/

# Blockchain runtime and temporary data
**/dev_data/
**/debug_data/
**/local_data/
**/runtime_data/

# Blockchain generated data files (not packages)
**/blockchain_data/
**/wallet_data/
**/transaction_data/
**/mining_data/
**/p2p_data/
**/api_data/
**/sync_data/
**/consensus_data/
**/monitoring_data/

# Blockchain backup and recovery data
**/backup_data/
**/recovery_data/
**/snapshots/

# Blockchain generated documentation
**/docs/generated/
**/docs/build/
**/docs/output/

# Blockchain build and release outputs
**/build/
**/dist/
**/release/
**/output/

# Blockchain IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Blockchain OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Blockchain temporary directories
**/tmp/
**/temp/
**/cache/
**/logs/

